# TikTok Upload Manager - Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# OpenAI API (Required for AI Captions)
# ========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# Optional: Override the default caption model (default: gpt-4.1-mini)
# OPENAI_CAPTION_MODEL=gpt-4.1-mini

# ========================================
# TikTok API (Required for Auto-Upload)
# ========================================
# Get credentials from: https://developers.tiktok.com/
# Create an app and get your Client Key and Client Secret
TIKTOK_CLIENT_KEY=your-tiktok-client-key-here
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret-here

# OAuth redirect URI (default: http://localhost:8000/callback)
# This must match what you configured in TikTok Developer Portal
TIKTOK_REDIRECT_URI=http://localhost:8000/callback

# ========================================
# Python Executable (Optional)
# ========================================
# Override the default Python path if needed
# TIKTOK_PYTHON_EXECUTABLE=/opt/homebrew/bin/python3

# ========================================
# Script Path (Optional)
# ========================================
# Override the default clip generator script path
# TIKTOK_PYTHON_SCRIPT=/Users/yourname/TikTokUploadManager/Python/clip_generator_cli.py
